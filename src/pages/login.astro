---
import Container from '@/components/ui/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { checkPassword, SESSION_COOKIE, sessionToken } from '@/lib/auth';

if (Astro.locals.isAdmin) return Astro.redirect('/');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (checkPassword(String(form.get('password') ?? ''))) {
    Astro.cookies.set(SESSION_COOKIE, sessionToken(), {
      httpOnly: true,
      sameSite: 'strict',
      secure: import.meta.env.PROD,
      path: '/',
      maxAge: 60 * 60 * 24 * 30,
    });
    return Astro.redirect('/');
  }
  // ponytail: flat delay slows guessing; add real rate limiting if this is exposed to the internet with a weak password
  await new Promise((resolve) => setTimeout(resolve, 1000));
  error = 'Wrong password';
}
---

<BaseLayout title="Sign in" showFooter={false}>
  <meta slot="head" name="robots" content="noindex" />
  <Container size="narrow" class="grid min-h-[70vh] place-items-center">
    <form method="post" class="w-full max-w-sm rounded-3xl border border-zinc-900/10 bg-white/70 p-8 shadow-xl shadow-zinc-900/5 backdrop-blur dark:border-white/10 dark:bg-zinc-900/60">
      <h1 class="text-2xl font-semibold tracking-tight">Welcome back</h1>
      <p class="mt-1 text-sm text-zinc-500">Sign in to write and edit posts.</p>
      <label for="password" class="mt-6 block text-sm font-medium">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        required
        autofocus
        autocomplete="current-password"
        class="mt-2 w-full rounded-xl border border-zinc-900/10 bg-white px-4 py-2.5 outline-none focus:border-accent-500 focus:ring-4 focus:ring-accent-500/15 dark:border-white/10 dark:bg-zinc-950"
      />
      {error && <p class="mt-3 text-sm text-red-500" role="alert">{error}</p>}
      <button type="submit" class="mt-6 w-full rounded-xl bg-zinc-900 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">
        Sign in
      </button>
    </form>
  </Container>
</BaseLayout>
