---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout title="Not found">
  <Container size="narrow" class="py-32 text-center">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-zinc-500">The page you are looking for doesn't exist or was removed.</p>
    <Button href="/" class="mt-8">Back home</Button>
  </Container>
</BaseLayout>
