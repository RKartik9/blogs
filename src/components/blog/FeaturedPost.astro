---
import Tag from '../ui/Tag.astro';
import Cover from './Cover.astro';
import PostMeta from './PostMeta.astro';
import type { Post } from '@/lib/types';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="group relative grid overflow-hidden rounded-[1.75rem] border border-white/[0.08] bg-white/[0.02] p-2 transition duration-500 hover:border-white/15 hover:bg-white/[0.035] lg:grid-cols-[1.35fr_1fr]">
  <Cover src={post.coverImage} title={post.title} loading="eager" class="aspect-[16/9] rounded-[1.35rem] lg:aspect-auto lg:min-h-96" />
  <div class="flex flex-col gap-5 p-5 sm:p-8 lg:p-10">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-accent-500/15 px-2.5 py-1 text-xs leading-none font-medium text-accent-400">Latest</span>
      {post.tags.slice(0, 2).map((tag) => <Tag name={tag} />)}
    </div>
    <h2 class="font-serif text-3xl leading-[1.15] font-medium tracking-tight text-balance sm:text-[2.5rem]">
      <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">{post.title}</a>
    </h2>
    <p class="line-clamp-3 leading-relaxed text-zinc-400 sm:text-lg">{post.excerpt}</p>
    <div class="mt-auto flex items-center justify-between border-t border-white/[0.08] pt-5">
      <PostMeta post={post} />
      <span class="inline-flex items-center gap-1.5 text-sm font-medium text-white">
        Read article <span class="text-accent-400 transition group-hover:translate-x-1">&rarr;</span>
      </span>
    </div>
  </div>
</article>
