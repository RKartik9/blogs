---
import Button from '../ui/Button.astro';
---

<div class="rounded-[1.75rem] border border-dashed border-white/15 px-6 py-24 text-center">
  <h2 class="font-serif text-2xl font-medium">Nothing published yet</h2>
  <p class="mt-2 text-zinc-500">The first story is on its way. Check back soon.</p>
  {Astro.locals.isAdmin && <Button href="/editor/new" class="mt-6">Write your first post</Button>}
</div>
