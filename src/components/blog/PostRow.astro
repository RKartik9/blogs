---
import PostMeta from './PostMeta.astro';
import type { Post } from '@/lib/types';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li>
  <a href={`/blog/${post.slug}`} class="group -mx-4 flex items-start justify-between gap-6 rounded-2xl px-4 py-6 transition hover:bg-white/[0.03]">
    <div class="min-w-0">
      <PostMeta post={post} />
      <h3 class="mt-2 font-serif text-2xl leading-snug font-medium tracking-tight text-balance">{post.title}</h3>
      {post.excerpt && <p class="mt-2 line-clamp-2 max-w-2xl text-zinc-400">{post.excerpt}</p>}
    </div>
    <span aria-hidden="true" class="mt-8 shrink-0 text-zinc-600 transition group-hover:translate-x-1 group-hover:text-accent-400">&rarr;</span>
  </a>
</li>
